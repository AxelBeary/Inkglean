# ============================================
# Caddy 配置 - 反向代理
# 修改 {$DOMAIN} 为你的实际域名
# ============================================

# 主域名（唯一入口）
# 画师主页通过路径访问：{$DOMAIN}/artist/:subdomain
# C48 决策：放弃子域名方案，统一路径访问。未来需要时 Caddy rewrite 转发，不做进应用层。
{$DOMAIN} {
	# 环境批 B1: 启用压缩（zstd 优先，回退 gzip；Caddy 2 内置编码器，无需插件）
	encode zstd gzip

	# 清扫批：Caddy 默认请求体上限 10MB，交付文件上限 50MB 会被截断 413——放宽到 55MB
	request_body {
		max_size 55MB
	}

	# CF 代理场景：用 Cloudflare 提供的真实用户 IP 覆盖 X-Forwarded-For（限流按人计，防边缘节点共享配额误伤）；
	# 无 CF-Connecting-IP（直连/本地）时占位符为空该头被删，后端回退用连接地址，行为仍真实。
	# 配套：开启 CF Authenticated Origin Pulls 防源站 IP 泄露后被绕 CF 伪造此头（见 OPS §12）。
	reverse_proxy web:3000 {
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
	}

	# 桌面端更新通道（825 施工批）：只读静态托管，只放流水线签名后经《更新通道执行手册》投递的成品；
	# latest.json 禁缓存保证客户端每次拿到最新清单，更新包本身可缓存；目录由 compose 只读挂载。
	handle_path /desktop/* {
		root * /srv/desktop-updates
		@manifest path /latest.json
		header @manifest Cache-Control "no-cache"
		file_server
	}
}
