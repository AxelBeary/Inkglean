# ============================================
# Artist Commission Platform - 环境变量配置
# 复制此文件为 .env 并修改实际值
# ============================================

# ── 必填 ──
# 会话签名密钥（生产环境必须设置，长度 ≥ 32 字符）
# 同时用于：JWT 签名、文件访问签名（HMAC）、Cookie 签名
SESSION_SECRET=

# Cookie 签名密钥（生产环境必须设置，长度 ≥ 32 字符）
# 用于 httpOnly cookie 的签名验证，防止 cookie 篡改
COOKIE_SECRET=

# 管理员 QQ 号（首次部署时自动创建管理员账号）
# ⚠️ 生产环境（NODE_ENV=production）必填：缺失且平台无管理员账号时，服务启动直接抛错退出
# （fail-fast，防止 TOTP 上线后无人能绑定/登录的死锁；已有管理员账号的重启场景可不设）
ADMIN_QQ=

# ── 部署模式 ──
# 生产环境：production（默认）
# 开发环境：development（会启用详细日志等）
NODE_ENV=production

# 开发模式（REQ-027 起语义变更）：true 时 TOTP 绑定接口返回密钥明文 _dev_secret（生产环境必须为 false）
AUTH_DEV_MODE=false

# ── 可选 ──
# 数据库路径（默认 /app/data/commission.db）
# DB_PATH=/app/data/commission.db

# 上传目录（默认 /app/uploads）
# UPLOAD_DIR=/app/uploads

# CORS 来源（多域名用逗号分隔）
# 留空 = 禁止跨域（生产推荐，前端与 API 同域部署）
# 开发环境可设为 http://localhost:5173
# CORS_ORIGIN=https://yourdomain.com

# 主域名（Caddy 使用）
# DOMAIN=yourdomain.com

# ── Sentry 错误监控（可选）──
# 后端 DSN（sentry.io → Node.js 项目 → Settings → Client Keys）
# 留空或不设 = 完全禁用，零网络请求
# NODE_ENV=development 时自动跳过上报
# SENTRY_DSN_BACKEND=

# 向后兼容别名（早期版本读 SENTRY_DSN；现优先 SENTRY_DSN_BACKEND，CSP 拼接仍读此名）
# SENTRY_DSN=

# ── 运行时配置 ──
# 监听端口（默认 3000；Docker 内由 EXPOSE 3000 固定，一般无需设置）
# PORT=3000

# 前端构建产物目录（默认 server 相对路径 web/dist；容器内由镜像构建固定，一般无需设置）
# WEB_DIST=/app/web/dist

# 反向代理信任（安全相关，生产必须配置）
# true = 信任所有代理（仅当 Caddy 为唯一入口且无其他来源时）
# false = 不信任任何代理
# 留空 = 默认信任 Docker 内网段 172.16.0.0/12,10.0.0.0/8,192.168.0.0/16（防伪造 X-Forwarded-For）
# 注意：docker-compose.yml 已显式注入 TRUST_PROXY，此处可不设
# TRUST_PROXY=true

# 容器环境标记（Docker/K8s 自动检测：存在即视为容器环境）
# 影响 SQLite journal_mode：Docker bind mount 不支持 WAL 共享内存，自动降级 DELETE 防数据丢失
# 一般由容器编排自动注入，本地开发无需设置
# DOCKER=1
# KUBERNETES_SERVICE_HOST=10.96.0.1

# ── 环境与安全（可选）──
# 容器/进程时区（影响 Node 进程本地时间口径与日志；业务日期换算走应用层 date.ts，与 SQLite 的 UTC 存储无关）
# docker-compose.yml 已显式固定 TZ=Asia/Shanghai（优先于 .env），此条目主要对原生部署生效
# 生产建议保持 Asia/Shanghai
# TZ=Asia/Shanghai

# ── WebAuthn / Passkey ──
# ⚠️ 以下两项生产环境（NODE_ENV=production）必填：缺失时服务在启动期直接拒绝启动
#    （fail-fast，同 SESSION_SECRET 口径；GHSA-6pf3-854w P1 整改——
#     rpId/Origin 按请求 Host 推导等价于「校验目标由调用方提供」，Host/X-Forwarded-Host 可被伪造）。
# 仅本地开发/测试可不设（自动按请求 Host 推导，默认 localhost）。

# WebAuthn/Passkey 的 RP ID（裸域名，不含协议与端口）
# WEBAUTHN_RP_ID=yourdomain.com

# WebAuthn/Passkey 校验的期望 Origin（协议 + 域名[:端口]，如 https://yourdomain.com）
# WEBAUTHN_ORIGIN=https://yourdomain.com

# 备份输出/恢复读取目录（server/scripts：backup-db、backup-uploads、restore-db 共用）
# 默认：仓库根 data/backups（容器内即 /app/data/backups，随 ./data 数据卷持久化）
# BACKUP_DIR=/app/data/backups

# 安装口令（开箱向导 /api/setup 首装时校验）
# ⚠️ 生产强烈建议设置；未设时首装向导免口令（初始化管理员无需任何凭证）
# install.mjs / setup.sh 首次部署会自动生成并写入 .env，也可手动预置
# SETUP_TOKEN=

# ── 已移除 ──
# LOGIN_CODE_*（登录错误码白名单）已移除：2026-08-15 复核 server/src 与 web/src 全库零引用，属死变量
