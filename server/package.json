{
  "name": "artist-commission-server",
  "version": "1.0.1",
  "description": "画师约稿管理平台 - 后端服务",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=22 <=26"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "lint": "eslint . && oxlint src tests",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test:watch": "vitest",
    "db:init": "tsx src/db/init.ts",
    "db:seed": "tsx src/db/seed.ts",
    "totp:rebind": "tsx scripts/totp-rebind.ts",
    "backup": "tsx scripts/backup-db.ts",
    "backup:uploads": "tsx scripts/backup-uploads.ts",
    "restore": "tsx scripts/restore-db.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^10.1.2",
    "@sentry/node": "^10.69.0",
    "@simplewebauthn/server": "^13.3.2",
    "ajv": "^8.20.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.0",
    "fastify": "^5.12.1",
    "isomorphic-dompurify": "^3.22.0",
    "nanoid": "^5.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "postcss": {
      "nanoid": "^3.3.18"
    },
    "ajv": {
      "fast-uri": "^3.1.7"
    },
    "fast-json-stringify": {
      "fast-uri": "^4.1.4"
    }
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true
  }
}
